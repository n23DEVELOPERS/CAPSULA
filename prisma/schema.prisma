generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DEV_DB_URL")
}

enum Roles {
  SUPERADMIN
  ADMIN
  DOCTOR
  PATIENT
}

enum Gender {
  MALE
  FEMALE
}

enum BookDoctorStatus {
    PENDING
    PROCESS
    SUCCESS
    CANCELLED
}

enum PaymentStatus {
    PENDING
    PAID
    CANCELLED
}

enum SendRole {
  DOCTOR
  PATIENT
}


enum Payment_type {
  CASH
  CARD
}

enum Wallet_type {
  HUMO
  UZCARD
  VISA
  MASTERCARD
}

enum DoctorSpeciality {
  CARDIOLOGIST
  DERMATOLOGIST
  NEUROLOGIST
  PEDIATRICIAN
  ORTHOPEDIC
  GYNECOLOGIST
  UROLOGIST
  ENDOCRINOLOGIST
  PSYCHIATRIST
  RADIOLOGIST
  ONCOLOGIST
  OPHTHALMOLOGIST
  OTOLARYNGOLOGIST
  DENTIST
  SURGEON
  NEPHROLOGIST
  HEMATOLOGIST
  GASTROENTEROLOGIST
}


model Admin {
  id              Int     @id @default(autoincrement())
  username        String  @unique
  phone_number    String  @unique
  hashed_password String
  role            Roles   @default(ADMIN)
  is_active       Boolean @default(true)
}

model Doctor {
  id              Int     @id @default(autoincrement())
  first_name      String
  last_name       String
  phone_number    String  @unique
  age             Int
  gender          Gender
  hashed_password String
  location        String
  is_active       Boolean @default(false)
  is_delete       Boolean @default(false)
  role            Roles   @default(DOCTOR)

  speciality       Speciality[]
  doctor_docs      Doctor_docs[]
  doctor_book_time Doctor_book_time[]
  service          Service[]
  book_doctor      Book_doctor[]
}

model Patient {
  id              Int     @id @default(autoincrement())
  first_name      String
  last_name       String
  phone_number    String  @unique
  age             Int
  gender          Gender  @default(MALE)
  hashed_password String
  location        String
  is_active       Boolean @default(true)
  role            Roles   @default(PATIENT)

  Book_doctor Book_doctor[]
  AiChat      AiChat[]
}

model Doctor_docs {
  id                  Int     @id @default(autoincrement())
  passport_url        String?
  diplom_url          String?
  certificate_url     String?
  self_employment_url String?
  image_url           String?
  doctor_id           Int
  doctor              Doctor  @relation(fields: [doctor_id], references: [id], onDelete: Cascade)
  Image               Image[]
}

model Image {
  id             Int         @id @default(autoincrement())
  image_url      String
  name           String
  doctor_docs_id Int
  docs           Doctor_docs @relation(fields: [doctor_docs_id], references: [id])
}

model Doctor_book_time {
  id         Int      @id @default(autoincrement())
  date       DateTime?
  is_active  Boolean  @default(true)
  doctor_id  Int
  doctor     Doctor   @relation(fields: [doctor_id], references: [id])
}

model Speciality {
  id          Int           @id @default(autoincrement())
  name        DoctorSpeciality @unique
  is_active   Boolean       @default(true)
  description String
  doctor      Doctor[]     
  Book_doctor Book_doctor[]
}

model Service {
  id          Int           @id @default(autoincrement())
  name        String
  price       Int
  description String
  doctor      Doctor[]
  Book_doctor Book_doctor[]
}

model Book_doctor {
  id        Int      @id @default(autoincrement())
  book_date DateTime
  is_active Boolean  @default(true)
  status    BookDoctorStatus   @default(PENDING)
  location  String

  service_id Int
  service    Service @relation(fields: [service_id], references: [id])

  speciality_id Int
  speciality    Speciality @relation(fields: [speciality_id], references: [id])

  patient_id Int
  patient    Patient @relation(fields: [patient_id], references: [id])

  doctor_id Int
  doctor    Doctor @relation(fields: [doctor_id], references: [id])

  Payment Payment[]
}

model Chat {
  id           Int       @id @default(autoincrement())
  doctor_id    Int
  patient_id   Int
  sender_role  SendRole
  message      String
  sent_at      DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}


model AiChat {
  id         Int      @id @default(autoincrement())
  patient_id Int
  patient    Patient  @relation(fields: [patient_id], references: [id])
  question   String
  answer     String
  createdAt  DateTime @default(now())
}

model Payment {
  id           Int          @id @default(autoincrement())
  status       PaymentStatus       @default(PENDING)
  patient_name String
  doctor_name  String
  payment_type Payment_type @default(CARD)
  meeting_date DateTime     @default(now())
  description  String

  book_doctor_id Int
  book_doctor    Book_doctor @relation(fields: [book_doctor_id], references: [id])
}

model Wallet {
  id          Int         @id @default(autoincrement())
  name        String
  card_number String      @unique
  type        Wallet_type @default(HUMO)
  date        String
  cvv         Int
  balence     Int         @default(0)
  patient_id     Int?
  doctor_id      Int?
}
